page{background:#faf9f7;color:#1a1a1a;font-family:system-ui;font-size:28rpx} .page{padding:28rpx} .brand{font-size:44rpx;font-weight:700;letter-spacing:4rpx;margin-bottom:20rpx}.row{display:flex;gap:12rpx;flex-wrap:wrap;align-items:center;margin:18rpx 0}.card{background:white;border:1rpx solid #e6e2dc;border-radius:20rpx;padding:24rpx;margin:18rpx 0}.title{font-size:34rpx;font-weight:600}.muted{color:#777;font-size:25rpx}.error{color:#a43f32;white-space:pre-wrap}button{font-size:26rpx;margin:0;border-radius:30rpx;background:#eee9e1}button.active{background:#142b4b;color:white}input,textarea,picker{background:white;border:1rpx solid #e6e2dc;border-radius:12rpx;padding:18rpx;margin:14rpx 0}textarea{width:auto;min-height:160rpx}.grid{display:grid;grid-template-columns:repeat(7,1fr)}.day{min-height:135rpx;border:1rpx solid #eee;padding:6rpx;font-size:24rpx}.day.selected{background:#e8edf3}.chip{font-size:19rpx;border-radius:5rpx;padding:3rpx;margin:4rpx 0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.poster{width:100%;height:750rpx;background:#eee}.note{white-space:pre-wrap;line-height:1.7}.label{margin-top:24rpx;color:#666}.row button{flex:0 0 auto;width:auto;min-width:0;padding:0 24rpx;line-height:2.2}.row picker{padding:10rpx;margin:4rpx 0}
.grid{grid-template-columns:repeat(7,minmax(0,1fr));width:100%}.day{min-width:0;box-sizing:border-box}.chip{max-width:100%}
