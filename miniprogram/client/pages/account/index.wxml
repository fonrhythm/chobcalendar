<view class="page"><view class="title">{{t.account}}</view><view class="error">{{error}}</view><button wx:if="{{!user}}" bindtap="login" loading="{{busy}}">{{t.login}}</button><view wx:if="{{!user}}" class="card"><view>{{t.bindHint}}</view><input value="{{linkCode}}" bindinput="inputCode" maxlength="64" placeholder="{{t.bindPlaceholder}}"/><button bindtap="bind" disabled="{{busy || !linkCode}}">{{t.bindLogin}}</button></view><block wx:else><view class="muted">{{t.signedIn}}</view><view class="row"><button bindtap="logout">{{t.logout}}</button><button bindtap="submit">{{t.submit}}</button></view><view class="label">{{t.myFavorites}}</view><view class="card" wx:for="{{favorites}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.name}} · {{item.activity}}</view><view class="label">{{t.mySubmissions}}</view><view class="card" wx:for="{{submissions}}" wx:key="id"><view>{{item.payload.activity}}</view><view>{{item.statusLabel}} · {{item.reply}}</view></view><view class="label">{{t.myCorrections}}</view><view class="card" wx:for="{{corrections}}" wx:key="id"><view class="note">{{item.content}}</view><view>{{item.statusLabel}} · {{item.reply}}</view></view></block></view>
