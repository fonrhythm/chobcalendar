<view class="page"><view class="title">{{t.submissionTitle}}</view><view wx:if="{{done}}" class="card">{{t.submissionDone}}</view><block wx:else><view class="muted">{{t.submissionHint}}</view><input value="{{artistQuery}}" bindinput="query" placeholder="{{t.artistSearch}}"/><checkbox-group bindchange="artists"><label wx:for="{{artists}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{item.name}}</label></checkbox-group><input value="{{form.name}}" data-key="name" bindinput="input" placeholder="{{t.unmatchedArtist}}" maxlength="200"/><input value="{{form.activity}}" data-key="activity" bindinput="input" placeholder="{{t.activityName}} *" maxlength="200"/><picker mode="date" value="{{form.date}}" data-key="date" bindchange="input">{{t.startDate}} * {{form.date}}</picker><picker mode="date" value="{{form.end_date}}" data-key="end_date" bindchange="input">{{t.endDate}} {{form.end_date}}</picker><input value="{{form.time}}" data-key="time" bindinput="input" placeholder="{{t.localTime}}"/><picker range="{{regions}}" data-key="region" bindchange="pick">{{t.region}} {{form.region}}</picker><input value="{{form.city}}" data-key="city" bindinput="input" placeholder="{{t.city}} *"/><input value="{{form.venue}}" data-key="venue" bindinput="input" placeholder="{{t.venue}}"/><picker range="{{types}}" range-key="name" data-key="type" bindchange="pick">{{t.eventTypes}} {{form.type}}</picker><picker range="{{conditions}}" range-key="name" data-key="participation_condition" bindchange="pick">{{conditionName}} *</picker><view wx:if="{{needsTask}}" class="card"><view>{{t.taskDetails}}</view><input value="{{task.title}}" data-key="title" bindinput="taskInput" placeholder="{{t.taskTitle}} *"/><picker mode="date" value="{{task.start_date}}" data-key="start_date" bindchange="taskInput">{{t.startDate}} * {{task.start_date}}</picker><picker mode="date" value="{{task.end_date}}" data-key="end_date" bindchange="taskInput">{{t.endDate}} {{task.end_date}}</picker><input value="{{task.start_time}}" data-key="start_time" bindinput="taskInput" placeholder="{{t.startTime}}"/><input value="{{task.end_time}}" data-key="end_time" bindinput="taskInput" placeholder="{{t.endTime}}"/><input value="{{task.action_url}}" data-key="action_url" bindinput="taskInput" placeholder="{{t.actionUrl}}"/><textarea value="{{task.description}}" data-key="description" bindinput="taskInput" placeholder="{{t.rules}}" maxlength="4000"/></view><textarea value="{{form.picture_url}}" data-key="picture_url" bindinput="input" placeholder="{{t.images}}" maxlength="4000"/><textarea value="{{form.note}}" data-key="note" bindinput="input" placeholder="{{t.note}}" maxlength="4000"/><view class="error">{{error}}</view><view class="row"><button bindtap="login">{{t.login}}</button><button bindtap="save">{{t.draft}}</button><button class="active" bindtap="submit" loading="{{busy}}">{{t.reviewSubmit}}</button></view></block></view>
