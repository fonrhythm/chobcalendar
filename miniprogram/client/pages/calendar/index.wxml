<view class="page"><view class="brand">CHOB CALENDAR</view><view class="row"><button wx:for="{{regions}}" wx:key="id" class="{{region===item.id?'active':''}}" data-key="region" data-value="{{item.id}}" bindtap="choose">{{item.name}}</button></view><input placeholder="{{t.search}}" value="{{query}}" data-key="query" bindinput="select"/><view class="row"><picker range="{{companies}}" data-key="company" bindchange="filter">{{t.company}} ({{selectedCompanies.length}})</picker><picker range="{{categories}}" range-key="name" data-key="category" bindchange="filter">{{t.artistTypes}} ({{selectedCategories.length}})</picker><picker range="{{activities}}" range-key="name" data-key="activity" bindchange="filter">{{t.eventTypes}} ({{selectedActivities.length}})</picker><picker range="{{artists}}" range-key="name" data-key="artist" bindchange="filter">{{t.artists}} ({{selectedArtists.length}})</picker><button bindtap="reset">{{t.reset}}</button></view><view class="row"><button wx:for="{{views}}" wx:key="*this" class="{{view===item?'active':''}}" data-key="view" data-value="{{item}}" bindtap="choose">{{t[item]}}</button><picker range="{{languages}}" bindchange="language">中文 / EN / ไทย</picker></view><view class="row"><button data-n="-1" bindtap="move">‹</button><picker mode="date" value="{{date}}" data-key="date" bindchange="select">{{date}}</picker><button data-n="1" bindtap="move">›</button><button bindtap="today">{{t.today}}</button></view><view class="error" wx:if="{{error}}">{{error}} · 缓存可能不是最新数据</view><button bindtap="refresh" loading="{{loading}}">{{t.retry}}</button><view wx:if="{{view==='month'}}" class="grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected?'selected':''}}" data-key="date" data-value="{{item.date}}" bindtap="choose"><text>{{item.number}}</text><view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="chip" style="background:{{event.isofficial?'transparent':event.color.bg}};color:{{event.isofficial?event.color.bg:event.color.text}};border:1px solid {{event.color.bg}}">{{event.isofficial?'★ ':''}}{{event.name}}</view><text wx:if="{{item.count>3}}">+{{item.count-3}}</text></view></view><view wx:for="{{groups}}" wx:key="date"><view class="label">{{item.date}}</view><view wx:if="{{!item.events.length}}" class="muted">{{t.empty}}</view><view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="card" data-id="{{event.id}}" bindtap="open"><view class="title">{{event.isofficial?'★ ':''}}{{event.name}}</view><view>{{event.activity}}</view><view class="muted">{{event.time}} · {{event.city}} · {{event.venue}}</view></view></view><view class="row"><button data-page="account" bindtap="navigate">{{t.account}}</button><button data-page="submit" bindtap="navigate">{{t.submit}}</button><button data-page="about" bindtap="navigate">{{t.about}}</button></view></view>