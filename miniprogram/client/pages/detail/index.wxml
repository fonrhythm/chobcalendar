<view class="page"><view class="error">{{error}}</view><block wx:if="{{event}}"><view class="title">{{event.name}}</view><view class="card"><view class="title">{{event.activity}}</view><view>{{event.date}} {{event.end_date?'— '+event.end_date:''}} · {{event.time}}</view><view>{{event.city}} · {{event.venue}}</view><view>{{event.event_status}}</view><view>{{event.participation_label}}</view><view class="note">{{event.participation_rules}}</view><view wx:if="{{channel}}">{{t.tickets}}：{{channel}}</view><view class="note">{{event.note}}</view></view><swiper wx:if="{{event.images.length}}" class="poster" indicator-dots="true"><swiper-item wx:for="{{event.images}}" wx:key="*this"><image class="poster" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="preview" binderror="imageFailed"/></swiper-item></swiper><view class="error">{{imageError}}</view><view class="row"><button bindtap="favorite">{{saved?'★':'☆'}} {{t.save}}</button><button open-type="share">{{t.share}}</button><button bindtap="correct">{{t.correct}}</button></view></block></view>