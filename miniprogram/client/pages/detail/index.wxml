<view class="page"><view class="error">{{error}}</view><block wx:if="{{event}}"><view class="title">{{event.name}}</view><view class="card"><view class="title">{{event.activity}}</view><view>{{event.date}} {{event.end_date?'— '+event.end_date:''}} · {{event.time}}</view><view>{{event.city}} · {{event.venue}}</view><view>{{event.event_status}}</view><view>{{event.participation_label}}</view><view wx:if="{{event.participation_rules}}" class="detail-rich-section"><view class="detail-rich-heading">活动详情与参与规则</view><rich-text class="detail-rich-content" nodes="{{descriptionHtml}}"/></view><view wx:if="{{channel}}">{{t.tickets}}：{{channel}}</view><view class="detail-rich-section"><view class="detail-rich-heading">备注</view><rich-text class="detail-rich-content" nodes="{{noteHtml}}"/></view></view><view wx:if="{{tasks.length}}"><view class="label">{{t.taskDetails}}</view><view wx:for="{{tasks}}" wx:key="id" class="card"><view class="title">{{item.activity}}</view><view>{{item.date}} {{item.end_date?"— "+item.end_date:""}} · {{item.time}} {{item.end_time?"— "+item.end_time:""}}</view><view wx:if="{{item.completion.closed}}">{{item.closureLabel}}</view><view class="note" wx:if="{{item.steps}}">{{item.steps}}</view><view wx:if="{{item.channel && !item.completion.closed}}">{{item.task_type==="ticketing"?t.tickets:t.taskChannel}}：{{item.channel}}</view><view wx:if="{{item.result_url}}" data-url="{{item.result_url}}" bindtap="copyResult">{{t.taskResults}}</view></view></view><swiper wx:if="{{event.images.length}}" class="poster" indicator-dots="true"><swiper-item wx:for="{{event.images}}" wx:key="*this"><image class="poster" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="preview" binderror="imageFailed"/></swiper-item></swiper><view class="error">{{imageError}}</view><view class="row"><button bindtap="favorite">{{saved?'★':'☆'}} {{t.save}}</button><button open-type="share">{{t.share}}</button><button bindtap="correct">{{t.correct}}</button></view></block></view>